{
  "issuer": "https://auth.example.test/application/o/openstack-keystone/",
  "authorization_endpoint": "https://auth.example.test/application/o/authorize/",
  "token_endpoint": "https://auth.example.test/application/o/token/",
  "userinfo_endpoint": "https://auth.example.test/application/o/userinfo/",
  "end_session_endpoint": "https://auth.example.test/application/o/openstack-keystone/end-session/",
  "introspection_endpoint": "https://auth.example.test/application/o/introspect/",
  "revocation_endpoint": "https://auth.example.test/application/o/revoke/",
  "jwks_uri": "https://auth.example.test/application/o/openstack-keystone/jwks/",
  "response_types_supported": ["code", "id_token", "id_token token", "code token", "code id_token", "code id_token token"],
  "response_modes_supported": ["query", "fragment", "form_post"],
  "grant_types_supported": ["authorization_code", "refresh_token", "implicit", "client_credentials", "password", "urn:ietf:params:oauth:grant-type:device_code"],
  "id_token_signing_alg_values_supported": ["RS256"],
  "subject_types_supported": ["public"],
  "scopes_supported": ["email", "profile", "openid"],
  "token_endpoint_auth_methods_supported": ["client_secret_post", "client_secret_basic"],
  "claims_supported": ["sub", "iss", "aud", "exp", "iat", "auth_time", "acr", "amr", "nonce", "email", "email_verified", "name", "given_name", "preferred_username", "nickname", "groups"],
  "code_challenge_methods_supported": ["plain", "S256"]
}
