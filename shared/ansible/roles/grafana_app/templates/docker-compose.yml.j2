services:
  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    restart: unless-stopped
    ports:
      - "{{ grafana_listen_address }}:{{ grafana_http_port }}:3000"
    environment:
      GF_SERVER_HTTP_ADDR: 0.0.0.0
      GF_SERVER_HTTP_PORT: "3000"
      GF_METRICS_ENABLED: "{{ grafana_metrics_enabled | lower }}"
      GF_PATHS_DATA: /var/lib/grafana
      GF_PATHS_LOGS: /var/log/grafana
      GF_PATHS_PLUGINS: /var/lib/grafana/plugins
      GF_PATHS_PROVISIONING: /etc/grafana/provisioning
      GF_SERVER_ROOT_URL: ${GRAFANA_ROOT_URL}
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
      GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
      GF_AUTH_GENERIC_OAUTH_NAME: Authentik
      GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP: "true"
      GF_AUTH_GENERIC_OAUTH_CLIENT_ID: ${GRAFANA_OIDC_CLIENT_ID}
      GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: ${GRAFANA_OIDC_CLIENT_SECRET}
      GF_AUTH_GENERIC_OAUTH_SCOPES: "openid profile email groups"
      GF_AUTH_GENERIC_OAUTH_AUTH_URL: ${GRAFANA_OIDC_ENDPOINT_BASE_URL}authorize/
      GF_AUTH_GENERIC_OAUTH_TOKEN_URL: ${GRAFANA_OIDC_ENDPOINT_BASE_URL}token/
      GF_AUTH_GENERIC_OAUTH_API_URL: ${GRAFANA_OIDC_ENDPOINT_BASE_URL}userinfo/
      GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH: preferred_username
      GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH: email
      GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH: groups
      GF_AUTH_GENERIC_OAUTH_ALLOWED_GROUPS: ${GRAFANA_OIDC_ALLOWED_GROUPS}
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: "contains(groups[*], 'grafana-admins') && 'GrafanaAdmin' || contains(groups[*], 'grafana-viewers') && 'Viewer' || 'None'"
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT: "true"
      GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN: "true"
      GRAFANA_TELEGRAM_BOT_TOKEN: ${GRAFANA_TELEGRAM_BOT_TOKEN}
      GRAFANA_TELEGRAM_CHAT_ID: ${GRAFANA_TELEGRAM_CHAT_ID}
    volumes:
      - grafana-data:/var/lib/grafana
      - grafana-logs:/var/log/grafana
      - ./provisioning:/etc/grafana/provisioning:ro

  prometheus:
    image: ${PROMETHEUS_IMAGE}
    container_name: prometheus
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=${PROMETHEUS_RETENTION}
      - --web.listen-address=:9090
      - --web.enable-admin-api
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus

  loki:
    image: ${LOKI_IMAGE}
    container_name: loki
    restart: unless-stopped
    command:
      - -config.file=/etc/loki/loki.yml
    ports:
      - "{{ grafana_listen_address }}:{{ grafana_loki_http_port }}:3100"
    volumes:
      - ./loki.yml:/etc/loki/loki.yml:ro
      - loki-data:/loki
    healthcheck:
      test: [CMD, /usr/bin/loki, -config.file=/etc/loki/loki.yml, -verify-config]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 15s

  blackbox-exporter:
    image: ${BLACKBOX_EXPORTER_IMAGE}
    container_name: blackbox-exporter
    restart: unless-stopped
    command: [--config.file=/etc/blackbox_exporter/config.yml]
    volumes:
      - ./blackbox.yml:/etc/blackbox_exporter/config.yml:ro

  pve-exporter:
    image: ${PVE_EXPORTER_IMAGE}
    container_name: pve-exporter
    restart: unless-stopped
    command: [--config.file=/etc/prometheus/pve.yml, --web.listen-address=0.0.0.0:9221]
    volumes:
      - ./pve.yml:/etc/prometheus/pve.yml:ro

  postgres-exporter:
    image: ${POSTGRES_EXPORTER_IMAGE}
    container_name: postgres-exporter
    restart: unless-stopped
    environment:
      DATA_SOURCE_URI: ${POSTGRES_EXPORTER_URI}
      DATA_SOURCE_USER: ${POSTGRES_EXPORTER_USER}
      DATA_SOURCE_PASS: ${POSTGRES_EXPORTER_PASSWORD}

  redis-exporter:
    image: ${REDIS_EXPORTER_IMAGE}
    container_name: redis-exporter
    restart: unless-stopped
    command:
      - --redis.addr=
      - --redis.password=${REDIS_EXPORTER_PASSWORD}
      - --append-instance-role-label

volumes:
  grafana-data:
  grafana-logs:
  prometheus-data:
  loki-data:
