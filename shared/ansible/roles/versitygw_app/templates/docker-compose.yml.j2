---
services:
  versitygw:
    image: ${VERSITYGW_IMAGE}
    container_name: versitygw
    restart: unless-stopped
    user: "1000:1000"
    ports:
      - "${VERSITYGW_PORT}:7070"
      - "${VERSITYGW_ADMIN_PORT}:7071"
    environment:
      ROOT_ACCESS_KEY: ${ROOT_ACCESS_KEY}
      ROOT_SECRET_KEY: ${ROOT_SECRET_KEY}
    command:
      - --port
      - :7070
      - --admin-port
      - :7071
      - --iam-dir
      - ${VERSITYGW_IAM_DIR}
      - posix
      - --versioning-dir
      - ${VERSITYGW_VERSIONING_DIR}
      - ${VERSITYGW_DATA_DIR}
    volumes:
      - ${VERSITYGW_DATA_DIR}:${VERSITYGW_DATA_DIR}
      - ${VERSITYGW_IAM_DIR}:${VERSITYGW_IAM_DIR}
      - ${VERSITYGW_VERSIONING_DIR}:${VERSITYGW_VERSIONING_DIR}
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:7070/"]
      interval: 30s
      timeout: 10s
      retries: 5
