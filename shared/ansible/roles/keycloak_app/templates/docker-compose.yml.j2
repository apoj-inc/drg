services:
  keycloak:
    image: ${KEYCLOAK_IMAGE}
    container_name: keycloak
    restart: unless-stopped
    command:
      - start
      - --import-realm
{% if keycloak_x509_proxy_provider_enabled | bool %}
      - --spi-x509cert-lookup--provider={{ keycloak_x509_proxy_provider }}
      - --spi-x509cert-lookup--{{ keycloak_x509_proxy_provider }}--certificate-chain-length={{ keycloak_x509_certificate_chain_length }}
{% endif %}
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: ${KEYCLOAK_ADMIN_USERNAME}
      KC_BOOTSTRAP_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD}
      KC_DB: postgres
      KC_DB_URL_HOST: ${KEYCLOAK_POSTGRESQL_HOST}
      KC_DB_URL_PORT: ${KEYCLOAK_POSTGRESQL_PORT}
      KC_DB_URL_DATABASE: ${KEYCLOAK_POSTGRESQL_DATABASE}
      KC_DB_URL_PROPERTIES: ${KEYCLOAK_POSTGRESQL_URL_PROPERTIES}
      KC_DB_USERNAME: ${KEYCLOAK_POSTGRESQL_USERNAME}
      KC_DB_PASSWORD: ${KEYCLOAK_POSTGRESQL_PASSWORD}
      KC_HTTP_ENABLED: "true"
      KC_HTTP_PORT: "8080"
      KC_HOSTNAME: ${KEYCLOAK_HOSTNAME}
      KC_PROXY_HEADERS: ${KEYCLOAK_PROXY_HEADERS}
      KC_PROXY_TRUSTED_ADDRESSES: ${KEYCLOAK_PROXY_TRUSTED_ADDRESSES}
      KC_CACHE: ${KEYCLOAK_CACHE}
      KC_CACHE_STACK: ${KEYCLOAK_CACHE_STACK}
      KC_HTTP_MANAGEMENT_PORT: ${KEYCLOAK_MANAGEMENT_PORT}
      KC_CACHE_EMBEDDED_NETWORK_BIND_PORT: ${KEYCLOAK_CLUSTER_PORT}
      KC_CACHE_EMBEDDED_NETWORK_EXTERNAL_ADDRESS: ${KEYCLOAK_CLUSTER_EXTERNAL_ADDRESS}
      KC_CACHE_EMBEDDED_NETWORK_EXTERNAL_PORT: ${KEYCLOAK_CLUSTER_EXTERNAL_PORT}
      KC_TRUSTSTORE_PATHS: ${KEYCLOAK_TRUSTSTORE_PATHS}
      KC_HEALTH_ENABLED: "true"
      KC_METRICS_ENABLED: "true"
      KEYCLOAK_FREEIPA_BIND_PASSWORD: ${KEYCLOAK_FREEIPA_BIND_PASSWORD}
    ports:
      - "${KEYCLOAK_LISTEN_ADDRESS}:${KEYCLOAK_HTTP_PORT}:8080"
      - "${KEYCLOAK_LISTEN_ADDRESS}:${KEYCLOAK_MANAGEMENT_PORT}:${KEYCLOAK_MANAGEMENT_PORT}"
      - "${KEYCLOAK_LISTEN_ADDRESS}:${KEYCLOAK_CLUSTER_PORT}:${KEYCLOAK_CLUSTER_PORT}"
      - "${KEYCLOAK_LISTEN_ADDRESS}:${KEYCLOAK_CLUSTER_FAILURE_DETECTION_PORT}:${KEYCLOAK_CLUSTER_FAILURE_DETECTION_PORT}"
    volumes:
      - ./import:/opt/keycloak/data/import:ro
      - ./certs:/opt/keycloak/certs:ro

    healthcheck:
      test:
        - CMD-SHELL
        - '{ printf "HEAD /health/ready HTTP/1.0\r\n\r\n" >&0; grep "HTTP/1.0 200"; } 0<>/dev/tcp/127.0.0.1/9000'
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 60s
