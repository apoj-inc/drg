api:
  dashboard: {{ ((traefik_dashboard_host | default('') | string | length) > 0) | ternary('true', 'false') }}
  insecure: false

global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO
  filePath: /var/log/traefik/traefik.log

accessLog:
  filePath: /var/log/traefik/access.log
  fields:
    headers:
      defaultMode: keep

ping: {}

{% if traefik_metrics_enabled | bool %}
metrics:
  prometheus:
    entryPoint: {{ traefik_metrics_entrypoint }}
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true
{% endif %}

entryPoints:
{% for entrypoint in traefik_managed_entrypoints %}
  {{ entrypoint.name }}:
    address: ":{{ entrypoint.port }}{% if entrypoint.protocol == 'udp' %}/udp{% endif %}"
{% endfor %}
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
    forwardedHeaders:
      trustedIPs:
        - "127.0.0.1/32"
        - "192.0.2.0/24"
        - "198.51.100.0/24"
        - "198.51.100.0/24"
        - "100.64.0.0/10"

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ traefik_acme_email }}"
      storage: /acme.json
      dnsChallenge:
        provider: "{{ traefik_dns_provider }}"
        resolvers:
          - "8.8.8.8:53"
          - "1.1.1.1:53"
        delayBeforeCheck: 30s
providers:
  file:
    directory: /etc/traefik/config
    watch: true
