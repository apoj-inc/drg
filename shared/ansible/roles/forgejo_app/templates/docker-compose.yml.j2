---
services:
  forgejo:
    image: ${FORGEJO_IMAGE}
    container_name: forgejo
    restart: unless-stopped
    ports:
      - "${FORGEJO_HTTP_PORT}:3000"
      - "${FORGEJO_SSH_PORT}:${FORGEJO_SSH_PORT}"
    volumes:
      - ${FORGEJO_DATA_DIR}:/data
      - ${FORGEJO_REPOSITORY_ROOT}:/data/git/repositories
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:3000/api/healthz"]
      interval: 30s
      timeout: 10s
      retries: 5
