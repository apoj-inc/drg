#!/usr/bin/env python3
"""Record a small streaming latency/throughput baseline."""

from __future__ import annotations

import json
import os
import subprocess
import time
import urllib.request


def load_env(path: str) -> dict[str, str]:
    result = {}
    with open(path, encoding="utf-8") as stream:
        for raw in stream:
            line = raw.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                result[key] = value
    return result


def main() -> None:
    env = load_env(os.environ.get("LLM_ENV_FILE", "/etc/llm/vllm-main.env"))
    base = os.environ.get("LLM_BASE_URL", f"http://127.0.0.1:{env['VLLM_PORT']}")
    payload = {
        "model": env["SERVED_MODEL_NAME"],
        "messages": [{"role": "user", "content": "Write a concise explanation of pipeline parallel inference."}],
        "max_tokens": 256,
        "temperature": 0,
        "stream": True,
        "stream_options": {"include_usage": True},
    }
    request = urllib.request.Request(
        f"{base}/v1/chat/completions",
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
    )
    started = time.monotonic()
    first_token = None
    completion_tokens = 0
    with urllib.request.urlopen(request, timeout=1800) as response:
        for raw in response:
            line = raw.decode().strip()
            if not line.startswith("data: ") or line == "data: [DONE]":
                continue
            event = json.loads(line[6:])
            delta = event.get("choices", [{}])[0].get("delta", {}) if event.get("choices") else {}
            if first_token is None and (delta.get("content") or delta.get("reasoning_content")):
                first_token = time.monotonic()
            completion_tokens = int(event.get("usage", {}).get("completion_tokens", completion_tokens))
    finished = time.monotonic()
    try:
        service_active_at = subprocess.check_output(
            ["systemctl", "show", "vllm-main", "-p", "ActiveEnterTimestamp", "--value"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        service_active_at = "unknown"
    decode_seconds = finished - (first_token or started)
    result = {
        "service_active_timestamp": service_active_at,
        "time_to_first_token_seconds": round((first_token or finished) - started, 3),
        "total_seconds": round(finished - started, 3),
        "completion_tokens": completion_tokens,
        "tokens_per_second_after_first": round(completion_tokens / decode_seconds, 3) if decode_seconds else None,
    }
    print(json.dumps(result, indent=2))
    output = os.environ.get("LLM_BENCHMARK_RESULT", "/srv/llm/logs/benchmark.json")
    with open(output, "w", encoding="utf-8") as stream:
        json.dump(result, stream, indent=2)
        stream.write("\n")


if __name__ == "__main__":
    main()
