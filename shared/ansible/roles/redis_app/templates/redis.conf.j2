bind {{ redis_listen_address }}
protected-mode no
port {{ redis_port }}
tcp-keepalive 60
timeout 0

dir {{ redis_data_dir }}
dbfilename dump.rdb
appendonly yes
appendfilename appendonly.aof
appendfsync everysec

requirepass {{ redis_password }}
masterauth {{ redis_password }}
replica-read-only yes
replica-announce-ip {{ ansible_ip | default(ansible_host, true) }}
replica-announce-port {{ redis_port }}

# Traefik uses this restricted account to determine whether this node is the
# current primary. It cannot read or modify Redis data.
user redis-health on nopass resetkeys resetchannels -@all +role

supervised systemd
loglevel notice
logfile ""
