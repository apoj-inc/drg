{
    "editable": false,
    "panels": [
        {
            "datasource": {
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "targets": [
                {
                    "expr": "sum(up{job=\"etcd\"})",
                    "refId": "A"
                }
            ],
            "title": "Members up",
            "type": "stat"
        },
        {
            "datasource": {
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 6,
                "y": 0
            },
            "id": 2,
            "targets": [
                {
                    "expr": "sum(etcd_server_is_leader)",
                    "refId": "A"
                }
            ],
            "title": "Leaders",
            "type": "stat"
        },
        {
            "datasource": {
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 12,
                "y": 0
            },
            "id": 3,
            "targets": [
                {
                    "expr": "sum(etcd_server_proposals_pending)",
                    "refId": "A"
                }
            ],
            "title": "Pending proposals",
            "type": "stat"
        },
        {
            "datasource": {
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "id": 4,
            "targets": [
                {
                    "expr": "increase(etcd_server_leader_changes_seen_total[1h])",
                    "legendFormat": "{{instance}}",
                    "refId": "A"
                }
            ],
            "title": "Leader changes",
            "type": "timeseries"
        },
        {
            "datasource": {
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "id": 5,
            "targets": [
                {
                    "expr": "rate(etcd_server_proposals_failed_total[5m])",
                    "legendFormat": "{{instance}} failures/s",
                    "refId": "A"
                },
                {
                    "expr": "etcd_server_proposals_pending",
                    "legendFormat": "{{instance}} pending",
                    "refId": "B"
                }
            ],
            "title": "Proposal failures and pending",
            "type": "timeseries"
        },
        {
            "datasource": {
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "id": 6,
            "targets": [
                {
                    "expr": "100 * etcd_mvcc_db_total_size_in_use_in_bytes / etcd_server_quota_backend_bytes",
                    "legendFormat": "{{instance}}",
                    "refId": "A"
                }
            ],
            "title": "Backend quota used %",
            "type": "timeseries"
        },
        {
            "datasource": {
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 14
            },
            "id": 7,
            "targets": [
                {
                    "expr": "histogram_quantile(0.99, sum by(le,instance) (rate(etcd_disk_wal_fsync_duration_seconds_bucket[5m])))",
                    "legendFormat": "{{instance}}",
                    "refId": "A"
                }
            ],
            "title": "WAL fsync p99",
            "type": "timeseries"
        },
        {
            "datasource": {
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 14
            },
            "id": 8,
            "targets": [
                {
                    "expr": "rate(etcd_network_disconnected_peers_total[5m])",
                    "legendFormat": "{{instance}}",
                    "refId": "A"
                }
            ],
            "title": "Peer disconnects",
            "type": "timeseries"
        }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
        "etcd",
        "cluster"
    ],
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "title": "etcd",
    "uid": "etcd",
    "version": 1
}