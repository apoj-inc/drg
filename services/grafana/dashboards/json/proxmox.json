{
  "editable": false,
  "panels": [
    {
      "datasource": {
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {"cellOptions": {"type": "auto"}}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {"id": "mappings", "value": [{"type": "value", "options": {"0": {"color": "red", "text": "Stopped"}, "1": {"color": "green", "text": "Running"}}}]},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}}
            ]
          }
        ]
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "id": 1,
      "options": {
        "cellHeight": "md",
        "showHeader": true
      },
      "targets": [
        {
          "expr": "pve_up * on(id) group_left(name) pve_guest_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Guest status",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "id": true, "instance": true, "job": true, "service": true},
            "indexByName": {"name": 0, "Value": 1},
            "renameByName": {"name": "Guest", "Value": "Status"}
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 76
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(pve_not_backed_up_total)",
          "refId": "A"
        }
      ],
      "title": "Guests without backup",
      "type": "stat"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "100 * (pve_cpu_usage_ratio * on(id) group_left(name) pve_guest_info)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Guest CPU %",
      "type": "timeseries"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "100 * ((pve_memory_usage_bytes / pve_memory_size_bytes) * on(id) group_left(name) pve_guest_info)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Guest RAM %",
      "type": "timeseries"
    },
    {
      "datasource": {"uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}, "unit": "percent"}},
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 28},
      "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true, "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * pve_cpu_usage_ratio{id=~\"node/(nas|server)\"}", "legendFormat": "{{id}}", "refId": "A"}],
      "title": "Node CPU %",
      "type": "timeseries"
    },
    {
      "datasource": {"uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}, "unit": "percent"}},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 28},
      "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true, "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * (pve_memory_usage_bytes{id=~\"node/(nas|server)\"} / pve_memory_size_bytes{id=~\"node/(nas|server)\"})", "legendFormat": "{{id}}", "refId": "A"}],
      "title": "Node RAM %",
      "type": "timeseries"
    },
    {
      "datasource": {"uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"fillOpacity": 8, "lineWidth": 2}, "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 38},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "rate(pve_disk_read_bytes_total[5m]) * on(id) group_left(name) pve_guest_info", "legendFormat": "{{name}} read", "refId": "A"},
        {"expr": "rate(pve_disk_written_bytes_total[5m]) * on(id) group_left(name) pve_guest_info", "legendFormat": "{{name}} write", "refId": "B"}
      ],
      "title": "Guest disk I/O throughput",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "proxmox",
    "pve"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Proxmox",
  "uid": "proxmox",
  "version": 11
}
