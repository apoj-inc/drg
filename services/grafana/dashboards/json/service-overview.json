{
  "editable": false,
  "panels": [
    {
      "datasource": {
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(up{service=~\"$service\"})",
          "refId": "A"
        }
      ],
      "title": "Targets up",
      "type": "stat"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(up{service=~\"$service\"} == 0)",
          "refId": "A"
        }
      ],
      "title": "Targets down",
      "type": "stat"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]},
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true, "sortBy": "Max", "sortDesc": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{service=~\"$service\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "CPU %",
      "type": "timeseries"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]},
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true, "sortBy": "Max", "sortDesc": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{service=~\"$service\"} / node_memory_MemTotal_bytes{service=~\"$service\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "RAM used %",
      "type": "timeseries"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 10}, {"color": "green", "value": 25}]},
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 5,
      "options": {
        "legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true, "sortBy": "Min", "sortDesc": false},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "100 * node_filesystem_avail_bytes{service=~\"$service\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{service=~\"$service\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "refId": "A"
        }
      ],
      "title": "Filesystem free %",
      "type": "timeseries"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "description": "Статистика маршрута соответствующего сервиса; выберите router при необходимости.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum by(router,code) (rate(traefik_router_requests_total{router=~\"$router\"}[5m]))",
          "legendFormat": "{{router}} {{code}}",
          "refId": "A"
        }
      ],
      "title": "Traefik RPS by route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by(service,code) (rate(traefik_service_requests_total{service=~\"$service\",code=~\"5..\"}[5m]))",
          "legendFormat": "{{service}} {{code}}",
          "refId": "A"
        }
      ],
      "title": "Traefik 5xx by backend service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,router) (rate(traefik_router_request_duration_seconds_bucket{router=~\"$router\"}[5m])))",
          "legendFormat": "{{router}}",
          "refId": "A"
        }
      ],
      "title": "Traefik p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 9,
      "targets": [
        {
          "expr": "sum by(instance) (rate(node_network_receive_bytes_total{service=~\"$service\",device!~\"lo|veth.*\"}[5m]))",
          "legendFormat": "{{instance}} rx",
          "refId": "A"
        },
        {
          "expr": "sum by(instance) (rate(node_network_transmit_bytes_total{service=~\"$service\",device!~\"lo|veth.*\"}[5m]))",
          "legendFormat": "{{instance}} tx",
          "refId": "B"
        }
      ],
      "title": "Network traffic",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "service",
    "traefik"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "uid": "prometheus"
        },
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "query": "label_values(up, service)",
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "uid": "prometheus"
        },
        "includeAll": true,
        "label": "Traefik router",
        "multi": true,
        "name": "router",
        "query": "label_values(traefik_router_requests_total, router)",
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Service detail — CPU, RAM and HTTP route",
  "uid": "service-overview",
  "version": 4
}
